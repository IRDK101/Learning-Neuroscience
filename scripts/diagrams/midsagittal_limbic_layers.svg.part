  <!-- ===================== Papez circuit and emotion structures ===================== -->
  <g data-layer="papez">
    <path data-ref="hippocampus" class="ghost" d="M 548 318 C 568 298 610 290 636 302 C 642 314 630 324 616 320 C 592 315 572 324 556 332 Z"/>
    <ellipse data-ref="amygdala" class="ghost" cx="527" cy="326" rx="15" ry="11"/>
    <path data-ref="subgenual-cingulate" class="ghost" d="M 276 262 C 280 246 300 240 314 250 C 320 262 312 278 296 280 C 284 280 274 274 276 262 Z"/>
    <path data-ref="fornix" class="line-hotspot" d="M 566 300 C 556 266 548 246 536 236 C 500 222 440 214 380 222 C 356 244 360 276 384 300 C 388 308 392 314 392 318"/>
    <circle data-ref="mammillary-bodies" cx="394" cy="322" r="8"/>
    <path class="proj" marker-end="url(#arr-papez)" d="M 590 300 C 574 262 560 238 532 228 C 490 214 430 208 386 216"/>
    <path class="proj" marker-end="url(#arr-papez)" d="M 400 318 C 406 300 408 284 406 262"/>
    <path class="proj" marker-end="url(#arr-papez)" d="M 420 240 C 426 220 430 196 434 176"/>
    <path class="proj" marker-end="url(#arr-papez)" d="M 470 160 C 560 150 640 200 640 270 C 640 288 630 298 618 304"/>
    <g class="labels">
      <text data-label-for="hippocampus" x="650" y="330" class="small">Hippocampus</text>
      <text data-label-for="amygdala" x="520" y="358" text-anchor="middle" class="small">Amygdala</text>
      <text data-label-for="fornix" x="470" y="236" text-anchor="middle" class="small">Fornix</text>
      <text data-label-for="mammillary-bodies" x="300" y="410" text-anchor="end" class="small">Mammillary body</text>
      <line data-label-for="mammillary-bodies" class="leader" x1="302" y1="404" x2="390" y2="328"/>
      <text data-label-for="subgenual-cingulate" x="230" y="300" text-anchor="end" class="small">Area 25</text>
      <line data-label-for="subgenual-cingulate" class="leader" x1="232" y1="296" x2="278" y2="270"/>
    </g>
  </g>

  <!-- ===================== default mode network (medial hubs) ===================== -->
  <g data-layer="dmn">
    <path data-ref="medial-prefrontal-cortex" class="ghost" d="M 150 190 C 170 150 230 140 260 170 C 280 200 270 260 240 300 C 210 330 160 320 146 280 C 138 250 140 214 150 190 Z"/>
    <path data-ref="posterior-cingulate-cortex" class="ghost" d="M 500 166 C 530 150 580 160 596 186 C 604 206 588 226 560 226 C 530 226 506 214 498 196 C 494 184 494 172 500 166 Z"/>
    <path class="proj" d="M 270 220 C 340 140 440 130 500 180"/>
    <g class="labels">
      <text data-label-for="medial-prefrontal-cortex" x="200" y="236" text-anchor="middle" class="small"><tspan x="200">Medial</tspan><tspan x="200" dy="15">prefrontal</tspan></text>
      <text data-label-for="posterior-cingulate-cortex" x="548" y="196" text-anchor="middle" class="small"><tspan x="548">Posterior</tspan><tspan x="548" dy="15">cingulate</tspan></text>
    </g>
  </g>
